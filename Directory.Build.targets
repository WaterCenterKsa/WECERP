<Project>
  <Target
    Name="StopExistingWecErpApiBeforeDebugBuild"
    BeforeTargets="PrepareForBuild"
    Condition="'$(OS)' == 'Windows_NT' And '$(Configuration)' == 'Debug' And '$(WecErpSkipProcessCleanup)' != 'true'">
    <Exec
      Command='powershell.exe -NoProfile -ExecutionPolicy Bypass -File "$(MSBuildThisFileDirectory)scripts\Stop-WecErpApi.ps1"'
      StandardOutputImportance="Low"
      StandardErrorImportance="High" />
  </Target>
</Project>
